# Keystone-MCP settings. Copy to .env and edit. Never commit .env.
# Every variable is documented in docs/environment.md.
#
# Two deployment profiles:
#   local       Your machine. DEV tokens allowed. BASE_URL must be localhost.
#   production  A public host. Google sign-in, no DEV tokens.
#
# Section 1 runs Keystone-MCP locally once RBAC_AUDIT_SUBJECT_SALT is set
# (and DEV_TOKENS plus SUPERADMIN_EMAIL, to sign in); setup.sh fills all three.
# Section 2 lists what production changes.
# Sections 3-10 are optional. Their lines show the default, commented out.
#
# `python -m keystone_mcp.server` and `keystone-mcp` both load this file (or
# the one named below) automatically before reading any other setting; a
# value already set in the process environment always wins over the file.
# Set KEYSTONE_MCP_ENV_FILE in the process environment (never in this file,
# since the file naming itself cannot be read from inside itself) to point at
# a different path, or to the empty string to disable loading entirely.

# ── 1. Local profile: start here ─────────────────────────────────────────────
# local: loopback only, DEV tokens allowed; production: enforce required, no DEV tokens.
KEYSTONE_MCP_DEPLOYMENT_PROFILE=local
KEYSTONE_MCP_BASE_URL=http://localhost:8080
# Use 0.0.0.0 inside a container.
KEYSTONE_MCP_HOST=127.0.0.1
KEYSTONE_MCP_PORT=8080
# Seconds to wait for in-flight HTTP requests after SIGTERM (default 25).
# KEYSTONE_MCP_SHUTDOWN_GRACE_SECONDS=25
KEYSTONE_MCP_REDIS_URL=redis://localhost:6379/0
# Booleans: 1/true/yes/on or 0/false/no/off (case and surrounding spaces ignored).
KEYSTONE_MCP_RBAC_MODE=enforce
KEYSTONE_MCP_RBAC_POLICY_PATH=config/rbac-policy.yaml
# Required while RBAC audit is on (startup refuses an empty value). Any
# random string; pseudonymizes people in the audit log.
KEYSTONE_MCP_RBAC_AUDIT_SUBJECT_SALT=
# WARNING: a DEV token is a shared password for local testing.
# Anyone who knows it can sign in as any email that exists in the users
# directory. The production profile refuses to start with DEV tokens.
KEYSTONE_MCP_DEV_TOKENS=
# Sign-in providers file (recommended for 0.5+). See docs/login-providers.md.
# KEYSTONE_MCP_LOGIN_PROVIDERS_PATH=/etc/keystone-mcp/login-providers.yaml
# Deprecated since 0.5.0 (kept until the next major version); use a providers file instead:
KEYSTONE_MCP_ENABLED_LOGIN_METHODS=api_key
KEYSTONE_MCP_PRIMARY_LOGIN_METHOD=api_key
# Email of the first administrator; created or restored at every start.
KEYSTONE_MCP_SUPERADMIN_EMAIL=
# Built-in users directory. A file next to the server is enough locally.
KEYSTONE_MCP_USERS_DB_URL=sqlite:///./keystone-users.db

# ── 2. Production profile: change these ──────────────────────────────────────
# KEYSTONE_MCP_DEPLOYMENT_PROFILE=production
# Walk through docs/production-checklist.md before going live.
# KEYSTONE_MCP_BASE_URL=https://mcp.example.com
# KEYSTONE_MCP_HOST=0.0.0.0
# Leave empty in production:
# KEYSTONE_MCP_DEV_TOKENS=
# Deprecated since 0.5.0 — prefer KEYSTONE_MCP_LOGIN_PROVIDERS_PATH (docs/login-providers.md):
# KEYSTONE_MCP_ENABLED_LOGIN_METHODS=google
# KEYSTONE_MCP_PRIMARY_LOGIN_METHOD=google
# KEYSTONE_MCP_GOOGLE_CLIENT_ID=
# KEYSTONE_MCP_GOOGLE_CLIENT_SECRET=
# Optional: accept only accounts from one Google Workspace domain.
# KEYSTONE_MCP_GOOGLE_ALLOWED_DOMAIN=
# Refuse an access token that names no resource (every modern MCP client does).
# KEYSTONE_MCP_REQUIRE_RESOURCE_INDICATOR=false
# Users directory on Postgres, shared by every replica.
# KEYSTONE_MCP_USERS_DB_URL=postgresql+psycopg://keystone:CHANGE_ME@postgres:5432/keystone

# ── 3. Upstream MCP services ─────────────────────────────────────────────────
# Preferred: a registry file. See examples/upstreams-registry.example.yaml.
# A registry entry's auth.bearer_env names an environment variable holding a
# bearer token Keystone sends to that upstream; the variable name is whatever
# the registry entry says (recommended shape: KEYSTONE_MCP_UPSTREAM_<NAMESPACE>_TOKEN),
# there is no fixed name here, and the token itself never goes in this file.
# A registry entry's auth.identity_secret_env names a second, separate
# variable: the HS256 secret Keystone signs the X-Keystone-Identity assertion
# with for that upstream (who is calling, their roles, the tool called). At
# least 32 bytes, generated with `openssl rand -base64 48`; the variable name
# is set in the registry, not here (recommended shape:
# KEYSTONE_MCP_UPSTREAM_<NAMESPACE>_IDENTITY_SECRET), and the secret itself
# never goes in this file.
# Optional EC P-256 PEM for ES256 identity assertions (auth.identity_alg: ES256).
# One line with \n escapes (multi-line values are not supported).
# Generate: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# KEYSTONE_MCP_IDENTITY_SIGNING_KEY=
# KEYSTONE_MCP_UPSTREAMS_PATH=/etc/keystone-mcp/upstreams.yaml
# Services on an internal Docker or Kubernetes network often speak plain http.
# Allow that only for addresses that are not reachable from the internet.
# KEYSTONE_MCP_UPSTREAM_ALLOW_INSECURE_HTTP=false
# Also needed (together with the line above) for localhost, *.local (e.g.
# *.svc.cluster.local), *.internal, or a private/loopback IP literal.
# KEYSTONE_MCP_UPSTREAM_EGRESS_ALLOW_PRIVATE=false
# Fallback: the same entries as one JSON array. Ignored when the file above exists.
# KEYSTONE_MCP_UPSTREAMS=
# KEYSTONE_MCP_UPSTREAM_DISCOVERY_RETRIES=3
# KEYSTONE_MCP_UPSTREAM_DISCOVERY_TIMEOUT=10
# true: refuse to start while any upstream is unreachable.
# KEYSTONE_MCP_UPSTREAM_REQUIRE_ALL=false
# How often tool lists and the policy file are re-read; 0 turns it off.
# KEYSTONE_MCP_REFRESH_INTERVAL_SECONDS=300
# KEYSTONE_MCP_UPSTREAM_TOOL_TIMEOUT_SECONDS=180
# Per-tool overrides, JSON: {"docs_export": 60}
# KEYSTONE_MCP_UPSTREAM_TOOL_TIMEOUTS=
# JSON file that adds properties to a proxied tool's input schema.
# KEYSTONE_MCP_PROXY_SCHEMA_PATCHES=
# true wraps proxied answers in {state, tool, task_id, result}, the 0.3.x behaviour.
# KEYSTONE_MCP_PROXY_STATUS_ENVELOPE=false
# KEYSTONE_MCP_PROXY_ELICITATION=true

# ── 4. Rate limits ───────────────────────────────────────────────────────────
# Limits count per process. With N replicas behind one load balancer a person
# can get up to N times the limit. Behind a reverse proxy the login limit sees
# the proxy's address unless FORWARDED_ALLOW_IPS is set in the service
# environment (not in this file — uvicorn reads it from the process env;
# docs/environment.md).
#
# Presets. Pick one and uncomment its lines. 0 turns a limit off.
#   local-dev     One developer, agents calling tools in a loop.
#                   THROTTLE_MAX=1000  THROTTLE_WINDOW=60  login: defaults
#   small-team    Up to about 20 people. Matches the defaults.
#                   THROTTLE_MAX=120   THROTTLE_WINDOW=60  LOGIN_THROTTLE_IP_MAX=30  LOGIN_THROTTLE_WINDOW=300
#   busy-gateway  Many agents per person, or many people behind one NAT.
#                   THROTTLE_MAX=300   THROTTLE_WINDOW=60  LOGIN_THROTTLE_IP_MAX=60  LOGIN_THROTTLE_WINDOW=300
#   strict-edge   Public host, few people, cautious.
#                   THROTTLE_MAX=30    THROTTLE_WINDOW=60  login: defaults
#
# Tool calls per person in the window:
# KEYSTONE_MCP_THROTTLE_MAX=120
# KEYSTONE_MCP_THROTTLE_WINDOW=60
# Login and registration attempts:
# KEYSTONE_MCP_LOGIN_THROTTLE_IP_MAX=30
# KEYSTONE_MCP_LOGIN_THROTTLE_EMAIL_MAX=10
# KEYSTONE_MCP_LOGIN_THROTTLE_WINDOW=300
# /authorize and /token attempts per client IP; a separate limit, same window.
# KEYSTONE_MCP_OAUTH_THROTTLE_IP_MAX=120

# ── 5. Sign-in and sessions ──────────────────────────────────────────────────
# KEYSTONE_MCP_TOKEN_TTL=86400
# KEYSTONE_MCP_AUTH_CODE_TTL=600
# KEYSTONE_MCP_REFRESH_TOKEN_TTL=2592000
# false: clients are registered manually, see docs/environment.md.
# KEYSTONE_MCP_OAUTH_DCR_ENABLED=true
# Cap on dynamically registered clients that have not expired; 0 means no cap.
# KEYSTONE_MCP_OAUTH_MAX_CLIENTS=10000
# Bare hostnames (no scheme, no port), comma-separated. When set, a client may
# only register and use redirect_uri values whose host is in this list; empty
# (the default) means no restriction, the 0.3.1 behaviour. A bare host allows
# https for that host and http only for loopback; a custom (non-http(s)) URI
# scheme, e.g. a native app's cursor://..., needs its own scheme://host entry.
# KEYSTONE_MCP_OAUTH_ALLOWED_REDIRECT_HOSTS=claude.ai,localhost,cursor://anysphere.cursor-retrieval
# Login page language when the browser asks for none we have: ar, en, he, ru.
# KEYSTONE_MCP_LOGIN_DEFAULT_LANG=en
# Name shown on the sign-in pages.
# KEYSTONE_MCP_LOGIN_BRAND=Keystone-MCP
# KEYSTONE_MCP_REDIS_KEY_PREFIX=km:oauth:
# KEYSTONE_MCP_LOGIN_PENDING_KEY_PREFIX=km:login:
# KEYSTONE_MCP_LOGIN_PENDING_TXN_TTL=600
# ── 6. Users directory ───────────────────────────────────────────────────────
# local, http, or the name of an installed directory plugin (see docs/plugins.md).
# KEYSTONE_MCP_USERS_BACKEND=local
# Optional YAML options for a directory plugin (ignored for built-in local/http).
# KEYSTONE_MCP_USERS_BACKEND_CONFIG=
# KEYSTONE_MCP_USERS_CACHE_ALLOW_TTL_SECONDS=60
# KEYSTONE_MCP_USERS_CACHE_DENY_TTL_SECONDS=30
# KEYSTONE_MCP_USERS_REDIS_REVISION_KEY=km:users:revision
# KEYSTONE_MCP_USERS_CIRCUIT_FAILURE_THRESHOLD=5
# KEYSTONE_MCP_USERS_CIRCUIT_RECOVERY_SECONDS=30
# Only for a fork that keeps users in its own HTTP service (see docs/adding-routes.md).
# KEYSTONE_MCP_USERS_SERVICE_URL=
# KEYSTONE_MCP_USERS_SERVICE_TOKEN=
# KEYSTONE_MCP_USERS_SERVICE_TIMEOUT_SECONDS=3
# KEYSTONE_MCP_USERS_SERVICE_ALLOW_INSECURE_HTTP=false

# ── 7. RBAC, audit and metrics ───────────────────────────────────────────────
# Optional list of tool names the policy may refer to before they go live.
# KEYSTONE_MCP_RBAC_CATALOG_SNAPSHOT=
# full, read-only or off: whether administrators may change the policy file through the policy_* tools.
# KEYSTONE_MCP_POLICY_TOOLS=full
# KEYSTONE_MCP_RBAC_AUDIT_ENABLED=true
# KEYSTONE_MCP_RBAC_AUDIT_LIST_TOOLS_SAMPLE_RATE=0.1
# /metrics has no password. Keep it off the internet.
# KEYSTONE_MCP_METRICS_ENABLED=false
# KEYSTONE_MCP_METRICS_PATH=/metrics
# full or coarse: how detailed the tool label is on call metrics.
# KEYSTONE_MCP_METRICS_TOOL_NAME=full
# Distinct oauth_client_id label values kept per process; rest report as "other".
# KEYSTONE_MCP_METRICS_OAUTH_CLIENT_ID_LIMIT=50
# Who may reach /metrics and /internal/* (comma-separated networks).
# KEYSTONE_MCP_INTERNAL_ALLOWED_CIDRS=127.0.0.1/32,::1/128
# KEYSTONE_MCP_INTERNAL_ENDPOINTS_ENABLED=false

# ── 8. Logging ───────────────────────────────────────────────────────────────
# KEYSTONE_MCP_LOG_LEVEL=INFO
# json or text
# KEYSTONE_MCP_LOG_FORMAT=json
# KEYSTONE_MCP_LOG_REDACT=true
# KEYSTONE_MCP_LOG_ACCESS_ENABLED=true
# KEYSTONE_MCP_LOG_REQUEST_ID_HEADER=X-Request-ID
# KEYSTONE_MCP_LOG_REQUEST_ID_RESPONSE=true

# ── 9. Server ────────────────────────────────────────────────────────────────
# MCP endpoint path. "/" serves MCP on the host root.
# KEYSTONE_MCP_HTTP_PATH=/
# Extra names (beyond KEYSTONE_MCP_BASE_URL and its loopback aliases) the Host
# guard accepts on the Host/Origin headers: a load balancer's hostname, an
# internal DNS name. Comma-separated; a bare host matches any port, host:port
# matches only that pair. /healthz and /readyz are exempt (a container
# healthcheck or Kubernetes probe reaches them by IP). See docs/security-model.md.
# /metrics and /internal/* are not exempt: add the exact address a scraper
# or catalog --live-url uses (e.g. 127.0.0.1:8080).
# KEYSTONE_MCP_ALLOWED_HOSTS=
