# Same as 0.4.0.env plus the providers file introduced in 0.5.0.
KEYSTONE_MCP_DEPLOYMENT_PROFILE=local
KEYSTONE_MCP_BASE_URL=http://localhost:8080
KEYSTONE_MCP_HOST=0.0.0.0
KEYSTONE_MCP_PORT=8080
KEYSTONE_MCP_REDIS_URL=redis://redis:6379/0
KEYSTONE_MCP_RBAC_MODE=enforce
KEYSTONE_MCP_RBAC_POLICY_PATH=/etc/keystone-mcp/rbac-policy.yaml
KEYSTONE_MCP_RBAC_AUDIT_SUBJECT_SALT=upgrade-stand-salt-not-secret
KEYSTONE_MCP_UPSTREAMS_PATH=/etc/keystone-mcp/upstreams.yaml
KEYSTONE_MCP_UPSTREAM_ALLOW_INSECURE_HTTP=true
KEYSTONE_MCP_UPSTREAM_HELLO_IDENTITY_SECRET=upgrade-hello-identity-secret-0123456789ab
KEYSTONE_MCP_ENABLED_LOGIN_METHODS=api_key
KEYSTONE_MCP_PRIMARY_LOGIN_METHOD=api_key
KEYSTONE_MCP_DEV_TOKENS=upgrade-dev-token
KEYSTONE_MCP_LOGIN_PROVIDERS_PATH=/etc/keystone-mcp/login-providers.yaml
KEYSTONE_MCP_SUPERADMIN_EMAIL=admin@upgrade.test
KEYSTONE_MCP_USERS_BACKEND=local
KEYSTONE_MCP_USERS_DB_URL=postgresql+psycopg://keystone:upgrade_pg_pass@postgres:5432/keystone
KEYSTONE_MCP_THROTTLE_MAX=1000
KEYSTONE_MCP_LOG_FORMAT=text
